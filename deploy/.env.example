# Copy to deploy/.env and fill in. Never commit .env.

# Domain for Caddy automatic HTTPS (use ":80" for local testing)
SITE_ADDRESS=app.example.com
COOKIE_SECURE=true

POSTGRES_PASSWORD=change-me
# openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
EMQX_DASHBOARD_PASSWORD=change-me

# MQTT credentials used by api/ingest (configure the same in EMQX authentication)
MQTT_SERVICE_USER=
MQTT_SERVICE_PASSWORD=

# Demo data: creates farm F1 with SEED_UNITS units (1 RAS each) of SEED_PONDS_MIN..MAX ponds
# on first start (a unit holds at most 10 ponds)
SEED_DEMO=false
SEED_UNITS=12
SEED_PONDS_MIN=4
SEED_PONDS_MAX=6

# Web Push (VAPID). Empty = generated once and stored in the DB. To pin them:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Alerts: crit re-pushed every N minutes until acknowledged; unacked warn escalated to managers
ALERT_CRIT_REPEAT_MIN=5
ALERT_WARN_ESCALATE_MIN=30

# Device commands expire if the PLC has not acknowledged them within this many seconds
CMD_TTL_SEC=30

# Simulator (only with --profile sim)
SIM_INTERVAL_SEC=10
SIM_BACKFILL_HOURS=48

# Image built by CI (ghcr.io/<owner>/sff-smart-shrimp:<tag>); defaults to local build
# IMAGE=ghcr.io/OWNER/sff-smart-shrimp:latest
